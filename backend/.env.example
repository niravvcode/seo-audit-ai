# Database Configuration
# For local PostgreSQL with Docker Compose:
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/seo_audit

# If local PostgreSQL is not installed, the app falls back to SQLite for local development:
USE_SQLITE_FALLBACK=true

# Optional AI Features (Gemini or OpenAI API key)
GEMINI_API_KEY=
OPENAI_API_KEY=

# Crawler Configuration
MAX_CRAWL_PAGES_LIMIT=50
DEFAULT_CRAWL_TIMEOUT_SECONDS=10.0
